# Dispersed API credentials (https://api.compute.x.io)
ZER_PUBLIC_KEY=                   # e.g. pk_abc123...
ZER_SECRET_KEY=                   # e.g. sk_abc123...

# Docker registry
DISPERSED_REGISTRY_HOST=registry.gitlab.com
DISPERSED_REGISTRY_USER=          # e.g. __token__ for GitLab
DISPERSED_REGISTRY_SECRET=        # Registry PAT / password with read_registry scope
DISPERSED_SSH_KEY="./dispersed-key"   # path to SSH private key file
DISPERSED_SSH_PUBKEY=             # SSH public key for duser (cat dispersed-key.pub)

# GPU workload image (test-gpu-workload*.py)
GPU_IMAGE=your-namespace/your-project/your-image
GPU_IMAGE_TAG=latest

# Batch workload image (test-batch-1.py) — falls back to GPU_IMAGE/GPU_IMAGE_TAG if unset
BATCH_GPU_IMAGE=your-namespace/your-project/your-batch-image
BATCH_GPU_IMAGE_TAG=latest

# S3 script runner batch image (test-batch-2.py) — falls back to BATCH_GPU_IMAGE if unset
S3_BATCH_GPU_IMAGE=your-namespace/your-project/your-s3batch-image
S3_BATCH_GPU_IMAGE_TAG=latest

# GitLab Model Registry (test-gpu-workload-4.py only)
GITLAB_TOKEN=                     # GitLab PAT with read/write access to packages and model registry
GITLAB_PROJECT_ID=                # Numeric project ID (found under Settings → General)
GITLAB_NAMESPACE=                 # namespace/project path (e.g. mygroup/myproject)
GITLAB_HOST=gitlab.com            # Override for self-hosted GitLab

# S3 volume mount (optional — set S3_BUCKET to auto-mount at /mnt/s3 inside the container)
S3_BUCKET=                        # e.g. my-dataset-bucket
S3_MOUNT_PATH=/tmp/s3             # Mount point inside the container (default: /tmp/s3 for batch, /mnt/s3 for persistent)
S3_SYNC_OPTS=                     # Extra aws s3 sync flags (optional, e.g. --exclude "*.tmp")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Runtime init (optional — shell snippet run inside the container before your workload)
INIT_SCRIPT=                      # e.g. "pip install transformers && huggingface-cli download gpt2"
